# Postgres-Connection für Drizzle (Migrations + Queries)
# Aus Supabase: Connect-Button oben rechts → Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-X-REGION.pooler.supabase.com:6543/postgres"

# Optional: feste Organisation auswählen (sonst wird die erste/älteste Org genutzt).
# Die Anmeldung wurde entfernt — die App läuft ohne Login auf genau dieser Org.
# ACTIVE_ORG_ID=

# Instantly.ai CLI — API-Key des Workspace "Sascha" (workspace-gebunden, nur dieser eine).
# Nutzung: `npm run instantly -- <befehl>` (z. B. `npm run instantly -- workspace get --pretty`).
# INSTANTLY_API_KEY=
