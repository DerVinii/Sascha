# Postgres-Connection für Drizzle (Migrations + Queries)
# Aus Supabase: Connect-Button oben rechts → Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-X-REGION.pooler.supabase.com:6543/postgres"

# Optional: feste Organisation auswählen (sonst wird die erste/älteste Org genutzt).
# Die Anmeldung wurde entfernt — die App läuft ohne Login auf genau dieser Org.
# ACTIVE_ORG_ID=

# Instantly.ai CLI — API-Key des Workspace "Sascha" (workspace-gebunden, nur dieser eine).
# Nutzung: `npm run instantly -- <befehl>` (z. B. `npm run instantly -- workspace get --pretty`).
# INSTANTLY_API_KEY=

# Postfach/Unibox: Shared Secret für den Instantly-Webhook (x-webhook-secret).
# Instantly signiert Webhooks nicht — der Webhook wird mit diesem Custom-Header
# registriert und /api/instantly/webhook prüft ihn. Beliebiger langer Zufallswert.
# Muss in Vercel UND bei der Webhook-Registrierung übereinstimmen.
# INSTANTLY_WEBHOOK_SECRET=

# Lead-Scraping: Google Places API (Text Search). Key aus Google Cloud Console,
# API "Places API (New)" aktivieren + Billing. Wird serverseitig genutzt.
# GOOGLE_PLACES_API_KEY=

# Lead-Enrichment: Gemini (mit Google-Search-Grounding). Key gratis bei
# Google AI Studio: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
